# Token bot Discord (bắt buộc)
DISCORD_TOKEN=

# Tiền tố lệnh kiểu cũ, mặc định là !
BOT_PREFIX=!

# Nơi cất sổ sinh tử
DB_PATH=data/tienlo.sqlite3

# Guild dùng để thử nghiệm: đặt ID vào đây thì slash command hiện ra ngay
GUILD_ID=

# Đặt 1 để rút ngắn mọi thời gian chờ (chỉ dùng khi thử nghiệm)
CAP_TOC=0
