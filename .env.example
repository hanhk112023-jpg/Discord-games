# Telegram Mini App là giao diện chính. Để trống token để chơi thử trong trình duyệt.
# Lấy token qua @BotFather; chỉ đặt trong .env trên máy chủ, không gửi cho client.
TELEGRAM_TOKEN=

# URL HTTPS công khai của Mini App, dùng cho nút mở game/menu bot.
TELE_MINIAPP_URL=
WEB_PORT=8080

# SQLite: dùng ổ đĩa bền vững và sao lưu định kỳ khi triển khai.
DB_PATH=data/tienlo.sqlite3

# Mã thế giới (giữ tên biến để tương thích dữ liệu cũ).
TELE_GUILD=1
# Telegram user ID được phép triệu boss thế giới / đổi trời, phân cách bằng dấu phẩy.
TELE_ADMIN_IDS=
BOSS_XAC_SUAT=0.5

# 1: rút ngắn cooldown, CHỈ dùng thử nghiệm.
CAP_TOC=0
# Có token thì mặc định chỉ nhận người dùng Telegram đã xác thực.
# Đặt 1 chỉ khi muốn mở thêm chế độ khách trên web; tiến độ khách tách khỏi Telegram.
TELE_ALLOW_GUEST=0
# Tùy chọn: chuỗi ngẫu nhiên đủ dài (>=32 byte) để ký cookie ổn định qua lần khởi động.
# Nếu trống: dùng token bot; nếu không có token thì tạo khóa tạm và phiên khách mất khi restart.
MINI_SESSION_SECRET=
