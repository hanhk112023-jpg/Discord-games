# Token bot Discord (bắt buộc)
DISCORD_TOKEN=

# Tiền tố lệnh kiểu cũ, mặc định là !
BOT_PREFIX=!

# Nơi cất sổ sinh tử
DB_PATH=data/tienlo.sqlite3

# Guild dùng để thử nghiệm: đặt ID vào đây thì slash command hiện ra ngay
GUILD_ID=

# Đặt 1 để rút ngắn mọi thời gian chờ (chỉ dùng khi thử nghiệm)
CAP_TOC=0

# ── bot Telegram (run_tele.py) ──
TELEGRAM_TOKEN=

# "thế giới" mà bot Telegram ghi sổ (dùng chung CSDL với Discord được; mặc định 1)
TELE_GUILD=1

# user id Telegram được phép triệu boss / đổi trời (phân cách bằng dấu phẩy)
TELE_ADMIN_IDS=

# xác suất mỗi vòng tuần tra có yêu vương thức tỉnh (0..1, mặc định 0.5)
BOSS_XAC_SUAT=0.5
